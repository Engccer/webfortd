# webfortd 환경변수 예시
#
# 이 파일을 `.env.local`로 복사한 뒤 필요한 키만 채운다(`.env.local`은 .gitignore로 차단된다).
# npm 스크립트(`kb:sync`·`kb:embed`·`test:integration` 등)는 `--env-file=.env.local`로 읽는다.
# 아래 "필수" 항목이 없으면 로그인·KB DB 조회·sync 스크립트가 런타임에 실패하고, 나머지는 해당 기능만 빠진다.
# 실제 값은 위원장 1Password 또는 각 대시보드에서 복사한다. Vercel production 등록 현황은
# `docs/M7_ENV_SETUP.md`·`docs/PHASE7_ENV_SETUP.md`가 정본.

# ── Supabase (장교조 khudt@khudt.net 계정, webfortd-prod 프로젝트) — 필수 ──────
# https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role(secret) 키. sync/embed 스크립트·서버 admin 클라이언트 한정, 클라이언트로 나가지 않는다.
SUPABASE_SECRET_KEY=

# ── 사이트 URL — 필수 ──────────────────────────────────────────────
# OTP 이메일의 redirect base. 로컬 http://localhost:3000, Vercel은 배포 도메인.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Gemini 직접 키 ──────────────────────────────────────────
# 임베딩(`kb:embed`, gemini-embedding-2-preview)·라이브 음성(`/api/voice/*`)이 쓴다.
# 텍스트 채팅(`/api/chat`)은 이 키가 아니라 Vercel AI Gateway(OIDC)를 경유한다 — 로컬 smoke는
# `docs/M3_SMOKE_PROCEDURE.md`.
GOOGLE_GENERATIVE_AI_API_KEY=
# 임베딩 모델·차원 override(선택). 미설정 시 scripts/lib/gemini-embed.ts 기본값.
# EMBED_MODEL=
# EMBED_DIM=

# ── 웹 콘텐츠 편집기(`/editor`) ────────────────────────────────────
# GitHub fine-grained PAT(khudt-org/webfortd Contents RW). 없으면 편집 반영이 실패한다.
GITHUB_CONTENT_TOKEN=
# 대상 저장소 override(선택). 기본 khudt-org/webfortd.
# GITHUB_CONTENT_REPO=

# ── 음성 받아쓰기(`/api/transcribe`, Deepgram) ─────────────────────
DEEPGRAM_API_KEY=

# ── 채팅 첨부 HWP/HWPX 파싱(Upstage Document Parse) ─────────────────
# production 미등록 상태(HWP/HWPX 첨부만 영향, `docs/M7_ENV_SETUP.md`).
UPSTAGE_API_KEY=

# ── 대화 정리 cron(`/api/cron/cleanup-chats`) Bearer 시크릿 ────────
CRON_SECRET=
