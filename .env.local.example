# webfortd 로컬 환경변수 예시 (실제 키는 .env.local에 — .gitignore로 차단됨)

# Supabase (장교조 khudt@khudt.net 계정, webfortd-prod 프로젝트)
# 실제 값은 위원장 1Password 또는 Supabase 대시보드(https://supabase.com/dashboard/project/<ref>/settings/api)에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key from Supabase dashboard>

SUPABASE_SECRET_KEY=sb_secret_<from dashboard Reveal — sync 스크립트 한정>

# Next.js 16 — 매직링크 redirect base.
# 로컬: http://localhost:3000, Vercel: vercel env add NEXT_PUBLIC_SITE_URL 별도 등록.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
